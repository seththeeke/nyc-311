# Schedule config for cto-agent (Rex Rivet, docs/17-executive-team.md §16)
# — sourced (POSIX sh) by scripts/agent-scheduled-run.sh and
# scripts/agent-schedule-install.sh. See docs/agent-automation-setup.md.

# Twice a day, two hours after devx-agent (06:00, 18:00), Mac mini local time.
# Re-run `scripts/agent-schedule-install.sh install cto-agent` after changing this.
SCHEDULE="08:00 20:00"

# One review pass per fire; there is no NEW/REVISE split for a reviewer.
KIND=operations

PROMPT_NEW="Scheduled code review for $(date '+%a %b %-d, %H:%M'). Follow your 'Each run' section: read the rubric and your inbox, review every open devx/ PR at a revision you haven't reviewed, mark each on GitHub and in #tech-team, and post the summary to #executive-team."

# Team Chat against Prod. No ops tools.
TEAM_CHAT_ENV=PROD
