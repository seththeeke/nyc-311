# Schedule config for chief-of-staff-agent (Penny Platen, docs/17-executive-team.md §15)
# — sourced (POSIX sh) by scripts/agent-scheduled-run.sh and
# scripts/agent-schedule-install.sh. See docs/agent-automation-setup.md.

# Once a day at 8:00 Central, which is 09:00 Mac mini local time (New York).
# Re-run `scripts/agent-schedule-install.sh install chief-of-staff-agent` after changing this.
SCHEDULE="09:00"

# An operating agent: every fire is one run, with no PRs or issues to count.
KIND=operations

# Sourced on every run, so the date is the run's own.
PROMPT_NEW="Scheduled morning brief for $(date '+%A, %B %-d, %Y'). Follow your 'Each run' section: find the window since your last brief, read every channel and thread in it, read your inbox, and post the brief to #executive-assistant."

# Team Chat only, against Prod. No ops tools.
TEAM_CHAT_ENV=PROD
