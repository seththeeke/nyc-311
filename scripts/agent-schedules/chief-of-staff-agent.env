# Schedule config for chief-of-staff-agent (Penny Platen, docs/17-executive-team.md §15)
# — sourced (POSIX sh) by scripts/agent-scheduled-run.sh and
# scripts/agent-schedule-install.sh. See docs/agent-automation-setup.md.

# Mac mini local time is Pacific (docs/17 §21.1). Once a day at 06:00 = 08:00 CT.
# Re-run `scripts/agent-schedule-install.sh install chief-of-staff-agent` after changing this.
SCHEDULE="06:00"

# An operating agent: every fire is one run, with no PRs or issues to count.
KIND=operations

# Sourced on every run, so the date is the run's own.
PROMPT_NEW="Scheduled morning brief for $(date '+%A, %B %-d, %Y'). Follow your 'Each run' section: find the window since your last brief, read every channel and thread in it, read your inbox, read the team's reports in the window, write your usage report, and post the brief to #executive-assistant."

# Team Chat only, against Prod. No ops tools.
TEAM_CHAT_ENV=PROD

# The brief is exempt from the 75-word cap on top-level posts (docs/17 §21.2).
CHAT_POST_WORDS=0

# A report folder per run, committed after it (docs/17 §21.3).
REPORTS=1

# The last 24 hours of Claude usage, appended to the prompt (docs/17 §21.4).
USAGE_SUMMARY=1
