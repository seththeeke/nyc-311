# Schedule config for gen-purpose-dev (Kid Kestrel, docs/17-executive-team.md
# §22) — sourced (POSIX sh) by scripts/agent-scheduled-run.sh and
# scripts/agent-schedule-install.sh. See docs/agent-automation-setup.md.

# board: each fire reads the Kid Kestral project board (agent-board.sh) and
# runs one session per card that needs him, each in its own worktree. A fire
# with nothing to do never starts `claude`.
KIND="board"

# 4 runs a day on Opus 5.5 (§22.6), in Pip's slots so Rex reviews an hour
# later. Mac mini time (Pacific); CT in brackets.
# 07:00 (09:00 CT), 13:00 (15:00 CT), 20:00 (22:00 CT), 02:00 (04:00 CT).
# Re-run `scripts/agent-schedule-install.sh install gen-purpose-dev` after changing this.
SCHEDULE="07:00 13:00 20:00 02:00"
MODEL="claude-opus-5-5"

# K1 (§22.11): specs only. Nothing moves to In Development until the CEO
# turns this on after reviewing a few specs.
BUILD=0
# In Development holds at most this many cards (§22.1); used once BUILD=1.
WIP_LIMIT=5
# Cards a run takes, each a separate session and worktree (§22.6).
MAX_CARDS_PER_RUN=3

# Team Chat (#tech-team) and the boroughsim-engineering tools (§22.9), against Prod.
TEAM_CHAT_ENV="PROD"
# Top-level posts are super brief (§22.6); detail goes in the thread and the ticket.
CHAT_POST_WORDS=25
ENGINEERING_TOOLS=1
# Warehouse queries per session (one card); the client's cap is 10.
ENGINEERING_QUERY_LIMIT=5

# Memory (§22.7) and one report per card (docs/17 §21.3).
MEMORY=1
REPORTS=1

# The wrapper appends "Your card: #<issue>" to the prompt.
PROMPT_SPEC="Scheduled run. Your card is in Assigned. Follow your 'Writing a spec' section for exactly the card named at the end of this prompt, and only that card."
