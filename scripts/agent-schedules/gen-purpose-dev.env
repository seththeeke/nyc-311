# Schedule config for gen-purpose-dev — sourced (POSIX sh) by
# scripts/agent-scheduled-run.sh and scripts/agent-schedule-install.sh.
# See docs/agent-automation-setup.md.

# assigned-issue: each fire polls GitHub for one issue carrying the
# `gen-purpose-dev` label that needs work, claims it, and runs the agent on it.
# A fire with nothing to do never starts `claude`, so polling often is cheap.
KIND="assigned-issue"

# Local times (HH:MM, space-separated) launchd fires the poll. Re-run
# `scripts/agent-schedule-install.sh install gen-purpose-dev` after changing this.
SCHEDULE="07:00 09:00 11:00 13:00 15:00 17:00 19:00 21:00"

# Open PRs whose head branch starts with this prefix count as this agent's.
# Branches are gen-purpose-dev/<issue-number>-<slug>.
BRANCH_PREFIX="gen-purpose-dev/"

# At or above this many open PRs, no NEW issue is claimed (RESUME and REVISE
# still run) — keeps the review queue from outgrowing the reviewer.
MAX_OPEN_PRS=3

# The wrapper appends the issue (and, for REVISE, the PR) to each prompt.
PROMPT_NEW="Scheduled run, NEW mode. You have been assigned this issue and it is already claimed for you (agent-planning). Follow your Workflow from step 1 for exactly this issue:"

PROMPT_RESUME="Scheduled run, RESUME mode. You parked this issue earlier and a human has replied. Follow your 'Resuming a parked issue' section for exactly this issue:"

PROMPT_REVISE="Scheduled run, REVISE mode. Your open PR has unaddressed review feedback or a merge conflict. Follow your 'Revision mode' section for exactly this PR:"
