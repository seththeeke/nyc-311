# Schedule config for aws-cost-agent (Grimble Tollbridge, docs/17-executive-team.md §18)
# — sourced (POSIX sh) by scripts/agent-scheduled-run.sh and
# scripts/agent-schedule-install.sh. See docs/agent-automation-setup.md.

# Mac mini local time is Pacific (docs/17 §21.1). Monday and Wednesday at
# 03:30 = 05:30 CT, so the cost report is ready for Penny's brief. Cut from
# daily on 2026-11-10 to make room for Kid Kestrel's usage.
# Re-run `scripts/agent-schedule-install.sh install aws-cost-agent` after changing this.
SCHEDULE="Mon@03:30 Wed@03:30"

# Open PRs whose head branch starts with this prefix count as this agent's,
# apart from Pip's devx/ PRs.
BRANCH_PREFIX="cost/"

# At or above this many open cost/ PRs, the run switches from NEW to REVISE mode.
MAX_OPEN_PRS=3

PROMPT_NEW="Scheduled cost run for $(date '+%A, %B %-d, %Y'), NEW mode. Follow your 'Each run' section: memory, inbox, tend your open cost/ PRs, read the bill (at most 8 Cost Explorer calls), judge what's due, then find and land one saving as a cost/ branch and PR if one clears the bar. Write your cost report and post its summary to #tech-team."

PROMPT_REVISE="Scheduled cost run for $(date '+%A, %B %-d, %Y'), REVISE mode: the open-PR limit is reached, so land no new change. Follow your 'Each run' section without steps 6 and 7: memory, inbox, tend these open cost/ PRs, read the bill, judge what's due, write your cost report and post its summary to #tech-team. Open PRs:"

# Sonnet: the daily bill read is routine work (docs/17 §18.5).
MODEL=sonnet

# Team Chat against Prod.
TEAM_CHAT_ENV=PROD

# Commit .claude/agent-memory/aws-cost-agent/ to main after a run that changed it (§18.3).
MEMORY=1

# A report folder per run, committed after it (§21.3).
REPORTS=1
