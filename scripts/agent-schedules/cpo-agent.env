# Schedule config for cpo-agent (Celestine Vey, docs/17-executive-team.md §17)
# — sourced (POSIX sh) by scripts/agent-scheduled-run.sh and
# scripts/agent-schedule-install.sh. See docs/agent-automation-setup.md.

# Daily, an hour after Rex's first run (08:00), Mac mini local time (New York).
# Re-run `scripts/agent-schedule-install.sh install cpo-agent` after changing this.
SCHEDULE="09:00"

# An operating agent: every fire is one run, with no PRs to count.
KIND=operations

PROMPT_NEW="Scheduled product run for $(date '+%A, %B %-d, %Y'). Follow your 'Each run' section: memory, inbox, contacts, WBR, your due reports, move the research agenda forward with at most 10 warehouse queries, file only what clears the bar, update each contact, post one message per new ticket and the daily report to #executive-team, and update memory and saved queries with what you learned."

# Team Chat and the boroughsim-product tools, against Prod.
TEAM_CHAT_ENV=PROD
PRODUCT_TOOLS=1

# Commit .claude/agent-memory/cpo-agent/ (MEMORY.md and queries/) to main after a run that changed it (§17.6, §17.11).
MEMORY=1
