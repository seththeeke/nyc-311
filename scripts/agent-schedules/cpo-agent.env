# Schedule config for cpo-agent (Celestine Vey, docs/17-executive-team.md §17)
# — sourced (POSIX sh) by scripts/agent-scheduled-run.sh and
# scripts/agent-schedule-install.sh. See docs/agent-automation-setup.md.

# Mac mini local time is Pacific (docs/17 §21.1). The audit at 07:00 CT, before
# Penny's brief; conversations at 10:00 13:00 16:00 19:00 CT (§21.4, §21.5).
# Re-run `scripts/agent-schedule-install.sh install cpo-agent` after changing this.
SCHEDULE="05:00=AUDIT 08:00=CONVERSE 11:00=CONVERSE 14:00=CONVERSE 17:00=CONVERSE"

# An operating agent: every fire is one run, of its slot's mode.
KIND=operations

PROMPT_AUDIT="Scheduled product run for $(date '+%A, %B %-d, %Y'): today's audit. Follow your 'Each audit' section: memory, inbox, contacts, WBR, your due reports, move the research agenda forward with at most 10 warehouse queries, file only what clears the bar, update each contact, write your product report, post one message per new ticket and the daily report to #executive-team, and update memory and saved queries with what you learned."
PROMPT_CONVERSE="Scheduled product run for $(date '+%A, %B %-d, %Y, %H:%M'): a conversation. Follow your 'Each conversation' section: memory, inbox and ticket threads with Rex, follow-ups on your open tickets, new contacts, at most 2 warehouse queries, and memory. No audit and no daily report."
# A manual run without a mode (AGENT_MODE unset, no slot mode) is the audit.
PROMPT_NEW="$PROMPT_AUDIT"

# Opus for the deep audit, Sonnet for the frequent conversations (§21.5).
MODEL_AUDIT=opus
MODEL_CONVERSE=sonnet

# The warehouse query budget for a conversation; the audit keeps the client's 10.
PRODUCT_QUERY_LIMIT_CONVERSE=2

# Team Chat and the boroughsim-product tools, against Prod.
TEAM_CHAT_ENV=PROD
PRODUCT_TOOLS=1

# Commit .claude/agent-memory/cpo-agent/ (MEMORY.md and queries/) to main after a run that changed it (§17.6, §17.11).
MEMORY=1

# A report folder per run, committed after it (§21.3).
REPORTS=1
