# Schedule config for coo-agent (Brogan Anvilhand, docs/17-executive-team.md §12)
# — sourced (POSIX sh) by scripts/agent-scheduled-run.sh and
# scripts/agent-schedule-install.sh. See docs/agent-automation-setup.md.

# Every 6 hours, Mac mini local time (New York). Re-run
# `scripts/agent-schedule-install.sh install coo-agent` after changing this.
SCHEDULE="02:00 08:00 14:00 20:00"

# An operating agent: every fire is one run, with no PRs or issues to count.
KIND=operations

PROMPT_NEW="Scheduled capacity check. Follow your 'Each run' section: read your inbox, read the capacity snapshot, decide, act within today's limits, and post to #executive-team."

# Team Chat plus the boroughsim-ops capacity tools, both against Prod.
TEAM_CHAT_ENV=PROD
OPS_TOOLS=1
