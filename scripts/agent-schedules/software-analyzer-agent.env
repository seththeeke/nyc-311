# Schedule config for software-analyzer-agent (Sable Marsh, docs/17-executive-team.md §19)
# — sourced (POSIX sh) by scripts/agent-scheduled-run.sh and
# scripts/agent-schedule-install.sh. See docs/agent-automation-setup.md.

# Mac mini local time is Pacific (docs/17 §21.1). Monday and Thursday at
# 21:30 = 23:30 CT. One package per run, so each run writes a full report.
# Re-run `scripts/agent-schedule-install.sh install software-analyzer-agent` after changing this.
SCHEDULE="Mon@21:30 Thu@21:30"

# An operating agent: every fire is one run, with no PRs to count.
KIND=operations

PROMPT_NEW="Scheduled code audit for $(date '+%A, %B %-d, %Y'). Follow your 'Each run' section: read the audits file and your memory, answer Rex, pick the package audited longest ago, audit the whole of it, file at most 3 tickets, write your report, post its summary to #tech-team, and update your memory."

# Opus: a whole-package audit needs the deeper model (docs/17 §19.3).
MODEL=opus

# Team Chat against Prod.
TEAM_CHAT_ENV=PROD

# Commit .claude/agent-memory/software-analyzer-agent/ to main after a run that changed it.
MEMORY=1

# A report folder per run, committed after it (§21.3), then synced to S3 for the Code Quality page (§19.6).
REPORTS=1
