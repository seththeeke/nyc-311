# Schedule config for devx-agent — sourced (POSIX sh) by
# scripts/agent-scheduled-run.sh and scripts/agent-schedule-install.sh.
# See docs/agent-automation-setup.md.

# Local times (HH:MM, space-separated) launchd fires the run. Re-run
# `scripts/agent-schedule-install.sh install devx-agent` after changing this.
SCHEDULE="06:00 18:00"

# Open PRs whose head branch starts with this prefix count as this agent's.
BRANCH_PREFIX="devx/"

# At or above this many open PRs, the run switches from NEW to REVISE mode.
MAX_OPEN_PRS=3

PROMPT_NEW="Scheduled run, NEW mode. Follow your Workflow from step 0: first tend your open devx/ PRs (unaddressed comments, merge conflicts), then prefer any backlog issue that asks for devx-agent, otherwise find, measure, and land one repo-health improvement as a branch + PR. Before choosing, check open devx/ PRs and open backlog issues (gh pr list / gh issue list --repo seththeeke/nyc-311) so you don't duplicate in-flight work. If nothing measurable is worth doing, say so and exit."

PROMPT_REVISE="Scheduled run, REVISE mode: the open-PR limit is reached, so do not start new work. Follow your 'Revision mode' section for each of these open PRs, resolving merge conflicts and addressing any unaddressed review comments:"
