{
  "name": "cdk",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "synth": "cdk synth --profile nyc311",
    "diff": "cdk diff --profile nyc311",
    "deploy": "cdk deploy --profile nyc311",
    "synth:pipeline": "cdk synth --profile nyc311 --app \"npx ts-node --prefer-ts-exts bin/pipeline.ts\"",
    "diff:pipeline": "cdk diff --profile nyc311 --app \"npx ts-node --prefer-ts-exts bin/pipeline.ts\"",
    "deploy:pipeline": "cdk deploy --profile nyc311 --app \"npx ts-node --prefer-ts-exts bin/pipeline.ts\""
  },
  "dependencies": {
    "aws-cdk-lib": "^2.264.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.0.5",
    "aws-cdk": "^2.1135.1",
    "eslint": "^9.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.5"
  }
}
