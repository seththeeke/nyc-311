# Checked into git (unlike .env.local) — these values are the same for
# every developer and every deployed environment. See
# docs/2-pipeline-monitoring.md §9 for why VITE_PIPELINE_API_BASE_URL in
# particular doesn't need per-environment runtime injection.

# Nyc311PipelineStatusApi's URL — a singleton, one value for both
# Nyc311-Test and Nyc311-Prod. Filled in during the bootstrap sequence
# (2-pipeline-monitoring.md §10) once Nyc311PipelineStack's first deploy
# with this API creates it.
VITE_PIPELINE_API_BASE_URL=https://vxw9vm74pa.execute-api.us-east-1.amazonaws.com
