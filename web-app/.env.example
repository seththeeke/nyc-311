# web-app environment variables — copy to `.env.local` (git-ignored) and
# adjust for local development. Vite reads these at build/dev time as
# `import.meta.env.*` (web-app/src/config.ts).
#
# `.env` and `.env.local` are BOTH git-ignored. Deployed builds get their
# values elsewhere: the pipeline's Synth step sets VITE_DATA_MODE and
# VITE_PIPELINE_API_BASE_URL (cdk/pipeline/Nyc311PipelineStack.ts), and
# each environment's real API URL is injected at deploy time into
# `/env-config.json` (loadRuntimeConfig), not baked into the bundle.

# "mock" (default) serves web-app/test-data fixtures; "live" calls the real API.
VITE_DATA_MODE=mock

# The public API base URL for "live" mode. Leave unset in mock mode.
# Deployed: https://api.boroughsim.com (prod) / https://api.test.boroughsim.com (test).
VITE_API_BASE_URL=

# Cognito User Pool / app client ids (9-admin-auth-integration.md §3) —
# per-environment like VITE_API_BASE_URL above, also injected at deploy
# time into /env-config.json rather than baked into the bundle. Only
# needed locally in "live" mode to exercise the real admin login.
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

# Nyc311PipelineStatusApi — a singleton, the same URL for every environment
# (2-pipeline-monitoring.md §9). Needed for the pipeline-monitoring tile.
VITE_PIPELINE_API_BASE_URL=https://vxw9vm74pa.execute-api.us-east-1.amazonaws.com
