      "Bash(gh issue comment *)",
      "Bash(gh issue edit * --add-label cto-escalated)",
      "Bash(gh api *)",
      "Bash(cd *)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run test:coverage)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(date *)",
      "Bash(echo *)",
      "Bash(aws --profile nyc311-cto-agent *)",
      "mcp__team-chat"
