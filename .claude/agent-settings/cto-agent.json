      "Glob",
      "TodoWrite",
      "Bash(git fetch *)",
      "Bash(git checkout --detach *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(gh --version)",
      "Bash(gh auth status)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
