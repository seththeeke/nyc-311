    "deny": [
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr review *)",
      "Bash(gh pr checkout *)",
      "Bash(gh repo *)",
      "Bash(cdk deploy *)",
      "Bash(npx cdk deploy *)",
      "Bash(npm run deploy *)",
      "Bash(npm run deploy)",
      "Read(**/nyc311-team-chat-*/**)",
      "Read(~/.aws/**)",
      "Read(~/.nyc-311/**)",
      "Bash(security *)",
      "Bash(aws cognito-idp *)",
      "Bash(aws --profile nyc311 *)",
      "Bash(aws * --profile nyc311 *)",
      "Bash(aws * --profile nyc311)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/team-chat-guard.sh"
          }
        ]
      }
    ]
