{
  "permissions": {
    "allow": [
      "TodoWrite",
      "mcp__team-chat",
      "Read(.claude/agent-reports/**)",
      "Glob(.claude/agent-reports/**)",
      "Grep(.claude/agent-reports/**)",
      "Write(.claude/agent-reports/**)",
      "Write(//tmp/**)",
      "Write(//private/tmp/**)"
    ],
    "deny": [
      "Bash",
      "Read(**/nyc311-team-chat-*/**)",
      "Read(~/.aws/**)",
      "WebFetch",
      "WebSearch",
      "Read(~/.nyc-311/**)",
      "Edit",
      "mcp__boroughsim-ops"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/team-chat-guard.sh"
          }
        ]
      }
    ]
  }
}
