{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration:local": "INTEGRATION_TARGET=local vitest run --config vitest.integration.config.ts",
    "test:integration:test": "INTEGRATION_TARGET=test vitest run --config vitest.integration.config.ts",
    "test:integration:prod": "INTEGRATION_TARGET=prod vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.1160.0",
    "@aws-sdk/client-cloudwatch": "^3.1160.0",
    "@aws-sdk/client-codepipeline": "^3.1160.0",
    "@aws-sdk/client-dynamodb": "^3.1160.0",
    "@aws-sdk/client-firehose": "^3.1160.0",
    "@aws-sdk/client-glue": "^3.1160.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/client-scheduler": "^3.1160.0",
    "@aws-sdk/client-sfn": "^3.1160.0",
    "@aws-sdk/client-sns": "^3.1160.0",
    "@aws-sdk/client-sqs": "^3.1160.0",
    "@aws-sdk/client-ssm": "^3.1160.0",
    "@aws-sdk/lib-dynamodb": "^3.1160.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "ulid": "^3.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.19.0",
    "standardwebhooks": "^1.1.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.6.1"
  }
}
