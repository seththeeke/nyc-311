{
  "name": "agent-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Localhost-only, read-only monitor for the agents scheduled on this machine (SPEC.md).",
  "scripts": {
    "start": "npm run build && NODE_ENV=production tsx server/main.ts",
    "dev": "concurrently -k -n server,web \"tsx watch server/main.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@tanstack/react-query": "^5.105.0",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "9.0.1",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "4.0.0",
    "tsx": "^4.23.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.7",
    "eslint": "^9.19.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
